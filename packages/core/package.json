{
  "name": "@unipay/core",
  "version": "1.0.0",
  "description": "Core unified API for UniPay SDK - provider-agnostic payment operations",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "payments",
    "sdk",
    "unified-api",
    "payment-gateway"
  ],
  "author": "Sarath Chandra Bellam",
  "license": "MIT",
  "dependencies": {
    "@unipay/utils": "^1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
